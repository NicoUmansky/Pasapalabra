# Variables de entorno para Supabase
# Copia este archivo a .env.local y configura tus valores

# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_aqui

# Nota: Estas variables son públicas y se incluyen en el bundle del cliente
# Para variables secretas, usa variables de servidor (sin NEXT_PUBLIC_)
